# Backend Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/thermacore_db
SECRET_KEY=your-super-secret-key-change-this
JWT_SECRET_KEY=your-jwt-secret-key-change-this
DEFAULT_ADMIN_PASSWORD=your-admin-password

# CORS Configuration
CORS_ORIGINS=https://your-frontend.netlify.app

# MQTT Configuration (Production)
MQTT_BROKER_HOST=your-mqtt-broker.com
MQTT_USERNAME=mqtt_username
MQTT_PASSWORD=mqtt_password
MQTT_USE_TLS=true
MQTT_CA_CERTS=/app/certs/ca.crt
MQTT_CERT_FILE=/app/certs/client.crt
MQTT_KEY_FILE=/app/certs/client.key

# OPC-UA Configuration (Production)
OPCUA_SERVER_URL=opc.tcp://your-opcua-server:4840
OPCUA_USERNAME=opcua_username
OPCUA_PASSWORD=opcua_password
OPCUA_SECURITY_POLICY=Basic256Sha256
OPCUA_SECURITY_MODE=SignAndEncrypt
OPCUA_CERT_FILE=/app/certs/opcua_cert.pem
OPCUA_PRIVATE_KEY_FILE=/app/certs/opcua_key.pem
OPCUA_TRUST_CERT_FILE=/app/certs/opcua_trust.pem

# Frontend Configuration
VITE_API_BASE_URL=https://your-backend.onrender.com
# Socket.IO uses VITE_API_BASE_URL and the /socket.io path
VITE_DATA_MODE=demo

# Live server device gateways (JSON keyed by unit id); see docs/PORTFOLIO_DATA_AND_REPORTING.md
UNIT_CONTROL_GATEWAYS={}

# Explicit backend demo services are disabled by default. Never enable in live deployments.
DEMO_DATA_ENABLED=false
# Required only when opting into backend demo account seeding (12+ characters).
DEMO_CLIENT_ADMIN_PASSWORD=

# Provider sign-in (register exact callbacks with each provider). No demo authentication.
AUTH_FRONTEND_URL=https://your-frontend.netlify.app
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/auth/oauth/google/callback
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_APPLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/auth/oauth/apple/callback
WEBAUTHN_RP_ID=your-frontend.netlify.app
WEBAUTHN_ORIGIN=https://your-frontend.netlify.app
# Optional public process topology JSON keyed by unit ID.
UNIT_PROCESS_DIAGRAMS={}

# Password-reset email delivery (verified SendGrid sender required)
SENDGRID_API_KEY=
EMAIL_FROM=
FRONTEND_URL=https://your-frontend.netlify.app
