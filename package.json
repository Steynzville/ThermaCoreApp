{
  "name": "thermacore-monitor-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0 <25.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-security.js --build",
    "preview": "vite preview",
    "start": "vite preview --port 10000 --host",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage",
    "test:coverage:frontend": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage --coverage.thresholds.lines=60",
    "test:coverage:backend": "cd backend && python -m pytest --cov=app --cov-report=term --cov-fail-under=60",
    "test:coverage:ci": "pnpm run test:coverage:frontend && pnpm run test:coverage:backend",
    "test:ci": "pnpm run test:coverage:ci",
    "type-check": "echo 'Type checking skipped - JavaScript project'",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "analyze": "cross-env ANALYZE=1 vite build",
    "security-check": "node scripts/check-security.js --build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "framer-motion": "^12.43.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^0.510.0",
    "react": "^19.3.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "socket.io-client": "4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.5.2",
    "rollup-plugin-visualizer": "^6.0.11",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
