{
  "name": "thermacore-monitor-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0 <25.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-security.js --build",
    "preview": "vite preview",
    "start": "vite preview --port 10000 --host",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage",
    "test:coverage:frontend": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=coverage --coverage.thresholds.lines=60",
    "test:coverage:backend": "cd backend && python -m pytest --cov=app --cov-report=term --cov-fail-under=60",
    "test:coverage:ci": "pnpm run test:coverage:frontend && pnpm run test:coverage:backend",
    "test:ci": "pnpm run test:coverage:ci",
    "type-check": "echo 'Type checking skipped - JavaScript project'",
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "analyze": "cross-env ANALYZE=1 vite build",
    "security-check": "node scripts/check-security.js --build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "axios": "^1.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "framer-motion": "^12.23.12",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "^0.510.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^2.15.4",
    "socket.io-client": "4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.6",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.11",
    "rollup-plugin-visualizer": "^6.0.3",
    "tw-animate-css": "^1.2.9",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
